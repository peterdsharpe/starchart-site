{
  "id": "./",
  "name": "Starchart",
  "short_name": "Starchart",
  "description": "A bike map and navigator that runs on your phone.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#07060d",
  "theme_color": "#07060d",
  "lang": "en",
  "categories": [
    "navigation",
    "travel"
  ],
  "icons": [
    {
      "src": "icons/icon-192-b51d593e7d23.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-4aeb8d44d48d.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192-9fefd45764b4.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512-5bb5d2b00e7c.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/monochrome-512-8b492ed70abc.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/flight.jpg",
      "sizes": "824x1830",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "In flight: the ship on a starpath, with its warp and the light years to go"
    },
    {
      "src": "screenshots/chart.jpg",
      "sizes": "824x1830",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "The chart at Fort Antwerp, with its starpaths and wormholes"
    },
    {
      "src": "screenshots/daystar.jpg",
      "sizes": "824x1830",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Daystar, the theme for day missions"
    }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            ".gpx",
            ".kml",
            ".geojson",
            ".json",
            "application/gpx+xml",
            "application/vnd.google-earth.kml+xml",
            "application/geo+json",
            "application/json",
            "application/xml",
            "text/xml",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
