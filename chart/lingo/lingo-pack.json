    "asteroid_belt":     { "label": "{base} Asteroid Belt", "status": "official", "strip": "river", "cadet": "{name}", "plain": "{name}", "codex": "a river", "voice": ["Crossing the {base} Asteroid Belt."], "plain_voice": ["Crossing the {name}."] },
    "heavy_nebula":      { "label": "The {base} Nebula", "status": "official", "strip": "water", "cadet": "{name}", "plain": "{name}", "codex": "a pond, lake or the sea", "voice": ["The {base} Nebula."], "plain_voice": ["{name}."] },
    "deep_space":        { "label": "Deep Space", "status": "official", "strip": "none", "cadet": "woods or trail", "plain": "{name}", "plain_unnamed": "Woods", "codex": "woods and unpaved trails", "voice": ["Entering deep space."], "plain_voice": ["Unpaved trail ahead."] },
    "space_dust":        { "label": "Space Dust", "status": "official", "strip": "none", "cadet": "gravel", "plain": "Gravel", "codex": "a gravel or sand surface", "voice": ["Space dust ahead."], "plain_voice": ["Gravel ahead."] },
    "comet_station":     { "label": "{base} Comet Station", "status": "proposed", "strip": "station", "cadet": "{name} station", "plain": "{name}", "plain_unnamed": "Train station", "codex": "a train or subway station", "voice": [] },
    "comet_trail":       { "label": "", "status": "proposed", "strip": "none", "cadet": "", "plain": "", "codex": "a railway line: a comet track", "voice": [] },
